# Which backend serves Claude: "bedrock" (default) or "anthropic"
LLM_PROVIDER=bedrock

# --- bedrock ---
# AWS credentials are picked up from the standard AWS credential chain
# (~/.aws/credentials, AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY env vars, or an
# assumed role) - no key goes here. The account needs Bedrock model access
# granted for BEDROCK_MODEL.
AWS_REGION=us-east-1
BEDROCK_MODEL=us.anthropic.claude-sonnet-5

# --- anthropic (direct API key, from console.anthropic.com) ---
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
